# ============================================================================
#  .env.staging  —  AMBIENTE DE STAGING (teste)  —  NÃO é produção
# ============================================================================
#
#  Copie este arquivo pra .env no serviço de STAGING do Railway (ou cole cada
#  variável no painel Railway → Variables do ambiente staging).
#
#  >>> REGRA DE OURO: NENHUM valor aqui pode apontar pro Supabase, Redis ou
#      domínio de PRODUÇÃO. Se um cliente real for afetado por um teste,
#      o staging perdeu todo o propósito. Reveja este arquivo com esse olhar.
#
#  Legenda:
#    [OBRIGATÓRIO]  o app não sobe / não funciona sem isso
#    [OPCIONAL]     só setar se for TESTAR aquele canal (voz/email/proxy/oficial)
#    [REUSÁVEL]     pode repetir o valor de prod sem risco (volume de teste)
# ============================================================================


# --- Identidade do ambiente -------------------------------------------------
NODE_ENV=production          # Railway roda "production" mesmo no staging (é build de produção)
PORT=3001                   # Railway injeta a porta; deixe 3001 como fallback local


# --- Banco de dados: Supabase STAGING  [OBRIGATÓRIO] ------------------------
#  ⚠️ ESTE É O PONTO CRÍTICO DE ISOLAMENTO.
#  Use as credenciais do PROJETO SUPABASE NOVO (staging), nunca as de prod.
#  Supabase → Project Settings → API.
SUPABASE_URL=https://SEU-PROJETO-STAGING.supabase.co
SUPABASE_KEY=eyJ...ANON_OU_SERVICE_DO_STAGING
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE_DO_STAGING   # usado por operações server-side

# Frontend (Vite) — MESMO projeto staging. Precisa da ANON key (pública).
VITE_SUPABASE_URL=https://SEU-PROJETO-STAGING.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...ANON_DO_STAGING


# --- Fila / sessões: Redis STAGING  [OBRIGATÓRIO] ---------------------------
#  ⚠️ Redis PRÓPRIO do staging (as sessões Baileys e a fila BullMQ vivem aqui).
#  Compartilhar o Redis de prod misturaria sessões de chip reais com as de teste.
#  No Railway: adicione um plugin Redis ao ambiente staging e use a URL dele.
REDIS_URL=redis://default:SENHA@HOST_REDIS_STAGING:PORT


# --- Domínio público do staging  [OBRIGATÓRIO p/ webhooks/voz] --------------
#  O domínio que o Railway gera pro serviço de staging (ex.: sdr-staging.up.railway.app).
#  Usado em links de webhook, mídia de voz e emails. NÃO use o domínio de prod.
PUBLIC_BASE_URL=https://SEU-STAGING.up.railway.app
APP_URL=https://SEU-STAGING.up.railway.app


# --- LLMs (cérebro dos agentes)  [OBRIGATÓRIO] [REUSÁVEL] -------------------
#  Pode reusar as chaves de prod: o volume de teste é baixo e não afeta clientes.
GROQ_API_KEY=gsk_...
TOGETHER_API_KEY=...


# --- Enriquecimento / busca  [OPCIONAL] [REUSÁVEL] -------------------------
SERPER_API_KEY=                 # busca Google p/ email/enrich; vazio = enrich degrada, app sobe
ENRICH_EMAIL_SERPER=false       # deixe false no staging p/ não gastar créditos à toa


# --- Alertas Discord  [OPCIONAL] -------------------------------------------
#  Recomendado: um canal Discord SEPARADO pro staging, pra não poluir os alertas
#  de produção. Se deixar vazio, os alertas só não são enviados.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_SUPORTE_URL=


# --- Proxy residencial (IPRoyal)  [OPCIONAL] -------------------------------
#  No staging com NÚMERO DE TESTE: deixe VAZIO. Sem proxy, o Baileys usa o IP do
#  Railway direto — suficiente pra número de teste. (A assinatura IPRoyal está
#  cancelada e não é necessária aqui.)
PROXY_BASE_URL=
PROXY_URL=


# --- Segurança / CORS  [OBRIGATÓRIO ajustar] -------------------------------
ADMIN_SECRET=defina-um-segredo-forte-SÓ-do-staging     # diferente do de prod
ALLOWED_ORIGINS=https://SEU-STAGING.up.railway.app     # origens permitidas (CORS)
CSP_ENABLED=true


# --- Puppeteer / Chrome (scraper)  [OPCIONAL no staging] -------------------
#  No Railway o nixpacks.toml instala o Chromium; normalmente não precisa setar.
#  Só descomente se for TESTAR o scraper de Google Maps no staging.
# CHROME_PATH=
# PUPPETEER_EXECUTABLE_PATH=
# HEADLESS=true
# BROWSER_ARGS=


# ============================================================================
#  CANAIS OPCIONAIS — só preencha se for TESTAR o canal no staging.
#  Deixe tudo vazio se só vai testar o WhatsApp receptivo (o caso comum).
# ============================================================================

# --- WhatsApp API Oficial (360dialog)  [OPCIONAL] --------------------------
#  Só se for testar o transporte oficial. Vazio = usa Baileys (não-oficial).
CLOUD_API_KEY=
CLOUD_BASE_URL=
WHATSAPP_VERIFY_TOKEN=                # token de verificação do webhook oficial

# --- Voz (Twilio + Deepgram + ElevenLabs)  [OPCIONAL] ----------------------
#  Só se for testar ligação com IA. Use um número Twilio de teste.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
DAILY_VOICE_MINUTES_BUDGET=30         # teto baixo no staging p/ não estourar custo
VOICE_COST_CENTS_PER_MIN=

# --- Email (Resend)  [OPCIONAL] --------------------------------------------
#  Só se for testar disparo de email. Use um domínio/remetente de teste.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
DAILY_EMAIL_BUDGET=20                  # teto baixo no staging

# --- Google Agenda / Confirmação de reuniões  [OPCIONAL] -------------------
#  Só se for testar a confirmação diária de reuniões (feature opt-in por tenant).
#  Google Cloud Console → APIs & Services: habilite "Google Calendar API", crie um
#  OAuth Client (tipo "Web application") e registre o Redirect URI abaixo (o do STAGING).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#  Precisa bater EXATAMENTE com o registrado no console (domínio do staging + a rota):
GOOGLE_OAUTH_REDIRECT_URI=https://SEU-STAGING.up.railway.app/api/google/oauth/callback
#  (Opcional) segredo próprio pra assinar o state do OAuth; se vazio usa ADMIN_SECRET.
GOOGLE_OAUTH_STATE_SECRET=
